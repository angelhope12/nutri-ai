# Copy to .env for local development only. In Vercel use Project Settings > Environment Variables.
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=
# Alternative to DATABASE_URL: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
SMTP_EMAIL=
SMTP_PASSWORD=
BLOB_READ_WRITE_TOKEN=
# Optional Google login: register the deployed HTTPS origin in Google Cloud.
GOOGLE_CLIENT_ID=
# Optional nutrition lookup.
USDA_API_KEY=
# Optional web push. Scheduled delivery requires a configured external cron.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:your-email@example.com
CRON_SECRET=
ENABLE_SCHEDULER=false
LOCAL_ML_CONFIDENCE_THRESHOLD=0.40
